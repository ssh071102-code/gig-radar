# Steps 3-4: the LLM used for scoring and drafting
# ANTHROPIC_BASE_URL: point this at any OpenAI/Anthropic-compatible gateway
# (e.g. https://your-gateway.example.com)
# Leave ANTHROPIC_BASE_URL empty to call the official Anthropic API directly
# (needs a sk-ant- key with account balance)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Step 5: Telegram push -- create a bot via @BotFather to get a token, message the
# bot once, then call getUpdates to read your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Reddit: v1 uses the logged-out .rss route (sources.yaml reddit.enabled=false), so
# the three lines below are unused -- leave them blank.
# Fill these in only if you later create a Reddit app and flip reddit.enabled to true.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=gig-radar/0.1 by /u/your-username
